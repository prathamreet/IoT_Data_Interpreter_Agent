# ── IoT Data Interpreter Agent — active settings ──────────────────────
# This file ships ready to run. EVERYTHING here is optional.
# The app works fully WITHOUT an API key (deterministic fallback narration).
#
# To turn ON live Claude AI: paste your key after the = sign below, save,
# then restart (re-run `docker compose up`). Nothing else to change.

ANTHROPIC_API_KEY=

# Models + reasoning effort (defaults are the most capable Claude models).
NARRATION_MODEL=claude-opus-4-8
INVESTIGATOR_MODEL=claude-opus-4-8
INVESTIGATOR_EFFORT=high

# Simulation + detection tuning (safe to leave as-is).
TICK_INTERVAL=1.5
WINDOW_SIZE=180
ANOMALY_CONTAMINATION=0.03
DEFAULT_SCENARIO=nominal

# Data source: simulator (default, no hardware) or mqtt (real sensors).
DATA_SOURCE=simulator

# ── Hardware path (only used when DATA_SOURCE=mqtt) ───────────────────
# With the optional broker (docker compose --profile hardware up), use:
# MQTT_HOST=mqtt
# MQTT_PORT=1883
# MQTT_TOPIC=sensors/#