# ── IoT Data Interpreter Agent — configuration ────────────────────────
# Copy to ".env" and fill in. EVERYTHING here is optional.
# The app runs fully WITHOUT an API key (deterministic fallback narration).
# Add a key to unlock live Claude narration + the agentic investigator.

# Your Anthropic API key. Leave blank to run in offline/fallback mode.
ANTHROPIC_API_KEY=

# Models (defaults are the most capable Claude models).
NARRATION_MODEL=claude-opus-4-8
INVESTIGATOR_MODEL=claude-opus-4-8

# Reasoning effort for the agentic investigator: low | medium | high | max
INVESTIGATOR_EFFORT=high

# Simulation + detection tuning
TICK_INTERVAL=1.5            # seconds between sensor samples
WINDOW_SIZE=180              # rolling window length per sensor (samples)
ANOMALY_CONTAMINATION=0.03   # Isolation Forest expected anomaly fraction
DEFAULT_SCENARIO=nominal     # nominal | hvac_failure | bearing_wear | sensor_malfunction | cold_chain_breach

# ── Hardware ingestion (placeholders — see backend/sources/mqtt_source.py) ──
# DATA_SOURCE=simulator      # simulator | mqtt
# MQTT_HOST=localhost
# MQTT_PORT=1883
# MQTT_TOPIC=sensors/#
